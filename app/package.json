{
  "name": "hiranoa",
  "version": "0.3.3",
  "description": "A fast, read-only Markdown viewer for local files.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/cocoabreak/hiranoa.git"
  },
  "homepage": "https://github.com/cocoabreak/hiranoa",
  "bugs": {
    "url": "https://github.com/cocoabreak/hiranoa/issues"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf:test": "node --test perf/*.test.mjs",
    "perf:build-app": "node perf/build-app.mjs",
    "perf:verify-app": "node perf/measure.mjs",
    "perf:verify-timings": "node perf/timing-suite.mjs",
    "perf:verify-memory": "node perf/memory-suite.mjs",
    "perf:compose": "node perf/compose-result.mjs",
    "perf:report": "node perf/report.mjs",
    "perf:ci": "node perf/ci.mjs",
    "e2e:smoke": "node e2e/smoke.mjs",
    "e2e:check-production": "node scripts/check-e2e-production.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@lucide/svelte": "^1.24.0",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "@traptitech/markdown-it-katex": "^3.6.0",
    "cytoscape": "^3.34.0",
    "dompurify": "^3.4.17",
    "js-yaml": "^5.2.1",
    "katex": "0.18.10",
    "markdown-it": "^15.0.3",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.16.0",
    "postcss": "^8.5.19",
    "postcss-prefix-selector": "^2.1.1",
    "shiki": "^4.4.3"
  },
  "overrides": {
    "katex": "$katex",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    },
    "deepmerge": "$deepmerge"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/markdown-it-emoji": "^3.0.1",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^24.19.2",
    "@types/postcss-prefix-selector": "^1.16.3",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "deepmerge": "file:vendor/deepmerge",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.108.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.0.0",
    "svelte-eslint-parser": "^1.8.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
